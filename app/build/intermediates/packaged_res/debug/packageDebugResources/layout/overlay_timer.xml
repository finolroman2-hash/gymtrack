<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_timer_overlay"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/topButtonsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/minimizeButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Minimizar"
            android:src="@drawable/ic_timer_minimize"
            android:tint="@color/timer_text" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:src="@drawable/ic_timer_close"
            android:tint="@color/timer_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="05:00"
        android:textColor="@color/timer_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/controlsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Iniciar"
            android:src="@drawable/ic_timer_play"
            android:tint="@color/timer_button_red" />

        <ImageButton
            android:id="@+id/stopButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Detener"
            android:src="@drawable/ic_timer_stop"
            android:tint="@color/timer_button_red" />

        <ImageButton
            android:id="@+id/resetButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Reiniciar"
            android:src="@drawable/ic_timer_reset"
            android:tint="@color/timer_button_red" />
    </LinearLayout>

    <TextView
        android:id="@+id/hintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="ajusta el temporizador en ajustes"
        android:textColor="@color/timer_text"
        android:textSize="11sp"
        android:alpha="0.7" />

</LinearLayout>
